{
  "cues": [
    {"id": 1, "display": "LT", "tc_in": "00:00:00,800", "tc_out": "00:01:24,751", "reference": "Matthew 5-7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "when Jesus taught the sermon on the Mount", "note": ""},
    {"id": 2, "display": "LT", "tc_in": "00:01:24,751", "tc_out": "00:01:28,421", "reference": "John 14-16", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "John chapter 14, 15 and 16", "note": ""},
    {"id": 3, "display": "LT", "tc_in": "00:01:28,755", "tc_out": "00:02:03,623", "reference": "Matthew 5-7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "This is a great teaching that helps us to grow", "note": "Exposition of the Sermon on the Mount"},
    {"id": 4, "display": "LT", "tc_in": "00:02:52,338", "tc_out": "00:02:55,909", "reference": "Matthew 5:1", "mention_type": "named_citation", "flag": null, "boundaries_estimated": false, "trigger_quote": "So here, Matthew chapter five and verse one", "note": "Lead-in"},
    {"id": 5, "display": "FS", "tc_in": "00:02:55,909", "tc_out": "00:03:00,046", "reference": "Matthew 5:1", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "and seeing the multitudes, he went up on the mountain", "note": "Reading of verse 1"},
    {"id": 6, "display": "LT", "tc_in": "00:03:00,046", "tc_out": "00:03:09,289", "reference": "Matthew 5:1", "mention_type": "named_citation", "flag": null, "boundaries_estimated": false, "trigger_quote": "That's where people come up with the term, sermon on the Mount", "note": "Expansion"},
    {"id": 7, "display": "FS", "tc_in": "00:03:09,289", "tc_out": "00:03:17,764", "reference": "Matthew 5:1", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "Now, notice, seeing the multitudes, he went up on a mountain, and his disciples came to him.", "note": "Second reading of verse 1 during exposition"},
    {"id": 8, "display": "LT", "tc_in": "00:03:17,764", "tc_out": "00:04:01,140", "reference": "Matthew 5:1-2", "mention_type": "paraphrase", "flag": null, "boundaries_estimated": false, "trigger_quote": "So Jesus saw the multitudes", "note": "Exposition of verses 1-2 in his own words"},
    {"id": 9, "display": "FS", "tc_in": "00:04:01,140", "tc_out": "00:04:09,148", "reference": "Matthew 5:2", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "And then he opened his mouth and taught them", "note": "Partial reading of verse 2"},
    {"id": 10, "display": "LT", "tc_in": "00:04:09,148", "tc_out": "00:04:50,323", "reference": "Matthew 5:2", "mention_type": "context_verse", "flag": null, "boundaries_estimated": false, "trigger_quote": "verse two, he taught them who them disciples", "note": "Exposition"},
    {"id": 11, "display": "LT", "tc_in": "00:04:50,323", "tc_out": "00:05:21,287", "reference": "Matthew 5-7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "The teaching in Matthew five six and seven", "note": ""},
    {"id": 12, "display": "LT", "tc_in": "00:05:21,287", "tc_out": "00:05:38,838", "reference": "Galatians 4:19", "mention_type": "named_citation", "flag": null, "boundaries_estimated": false, "trigger_quote": "the apostle Paul prayed in Galatians 419 that Christ might be formed in them", "note": "Paraphrase, no reading"},
    {"id": 13, "display": "LT", "tc_in": "00:05:38,838", "tc_out": "00:06:24,751", "reference": "Matthew 5-7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "In Matthew five six and seven, the focus is spiritual growth", "note": ""},
    {"id": 14, "display": "LT", "tc_in": "00:06:24,751", "tc_out": "00:06:32,191", "reference": "Matthew 7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "I want to go to the end of the, of this in chapter seven", "note": ""},
    {"id": 15, "display": "LT", "tc_in": "00:06:32,191", "tc_out": "00:06:35,628", "reference": "Matthew 5", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "And then we're going to come back, in chapter five", "note": ""},
    {"id": 16, "display": "LT", "tc_in": "00:06:35,628", "tc_out": "00:06:48,674", "reference": "Matthew 7:24", "mention_type": "named_citation", "flag": null, "boundaries_estimated": false, "trigger_quote": "So look with me at chapter seven and verse 24, Jesus said", "note": "Lead-in"},
    {"id": 17, "display": "FS", "tc_in": "00:06:48,674", "tc_out": "00:07:00,653", "reference": "Matthew 7:24", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "Therefore, whoever hears these sayings of mine and does them, I will liken him to a wise man. The built his house on the rock.", "note": "Reading of verse 24"},
    {"id": 18, "display": "FS", "tc_in": "00:07:00,653", "tc_out": "00:07:10,196", "reference": "Matthew 7:25", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "The rain descended, the floods came, the winds blew. Beat on that house, and it did not fall. For was founded on the rock.", "note": "Reading of verse 25"},
    {"id": 19, "display": "LT", "tc_in": "00:07:10,196", "tc_out": "00:08:14,760", "reference": "Matthew 7:24-25", "mention_type": "paraphrase", "flag": null, "boundaries_estimated": false, "trigger_quote": "How to build your house on the rock", "note": "Exposition of verses 24-25"},
    {"id": 20, "display": "LT", "tc_in": "00:08:14,760", "tc_out": "00:08:53,833", "reference": "Matthew 5-7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "Jesus, Matthew five six and seven", "note": "Speaker identifies the sayings as Matthew 5-7"},
    {"id": 21, "display": "LT", "tc_in": "00:08:53,833", "tc_out": "00:08:58,604", "reference": "Luke 6:47-48", "mention_type": "named_citation", "flag": null, "boundaries_estimated": false, "trigger_quote": "Luke six was recorded the same message and said, verse 47 and 48", "note": "Lead-in"},
    {"id": 22, "display": "FS", "tc_in": "00:08:58,604", "tc_out": "00:09:08,147", "reference": "Luke 6:47", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "whoever comes to me and hears my sayings and does them, I will show you whom he's like", "note": "Reading of verse 47"},
    {"id": 23, "display": "FS", "tc_in": "00:09:08,147", "tc_out": "00:09:24,196", "reference": "Luke 6:48", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "He's like a man building a house who dug deep, laid the foundation on a rock. And when the flood arose... Absolutely could not shake it.", "note": "Reading of verse 48"},
    {"id": 24, "display": "LT", "tc_in": "00:09:24,196", "tc_out": "00:09:51,004", "reference": "Luke 6:48", "mention_type": "paraphrase", "flag": null, "boundaries_estimated": false, "trigger_quote": "Yes, if we fall to pieces when problems and trials and difficulties come to us", "note": "Exposition"},
    {"id": 25, "display": "LT", "tc_in": "00:09:51,004", "tc_out": "00:09:53,826", "reference": "1 Corinthians 3:11", "mention_type": "named_citation", "flag": null, "boundaries_estimated": false, "trigger_quote": "First Corinthians three says, for other", "note": "Lead-in"},
    {"id": 26, "display": "FS", "tc_in": "00:09:53,826", "tc_out": "00:10:00,833", "reference": "1 Corinthians 3:11", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "no other foundation can anyone lay that is laid, which is Jesus Christ", "note": "Reading of verse 11"},
    {"id": 27, "display": "LT", "tc_in": "00:10:00,967", "tc_out": "00:10:23,556", "reference": "Matthew 5-7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "Jesus taught in my Matthew five, six and seven", "note": ""},
    {"id": 28, "display": "LT", "tc_in": "00:10:23,556", "tc_out": "00:10:29,862", "reference": "Matthew 5:1-2", "mention_type": "context_verse", "flag": null, "boundaries_estimated": false, "trigger_quote": "Back to Matthew five, verses one and two", "note": "Lead-in"},
    {"id": 29, "display": "FS", "tc_in": "00:10:29,862", "tc_out": "00:10:33,199", "reference": "Matthew 5:1", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "he went up on a mountain, and when he was seated, his disciples came to him", "note": "Reading of verse 1"},
    {"id": 30, "display": "FS", "tc_in": "00:10:33,699", "tc_out": "00:10:37,069", "reference": "Matthew 5:2", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "Then he opened his mouth and taught them, saying", "note": "Reading of verse 2"},
    {"id": 31, "display": "LT", "tc_in": "00:10:37,470", "tc_out": "00:10:47,780", "reference": "Matthew 5-7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "and so this teaching is essential in becoming a disciple of Jesus", "note": ""},
    {"id": 32, "display": "LT", "tc_in": "00:10:47,780", "tc_out": "00:10:56,722", "reference": "Matthew 28:19-20", "mention_type": "named_citation", "flag": "verify", "boundaries_estimated": false, "trigger_quote": "Remember he said in Matthew 28 that you're going to go into the world and make disciples, teaching them to observe all that I've taught you", "note": "Speaker gave chapter 28 only; verses inferred from the content"},
    {"id": 33, "display": "LT", "tc_in": "00:10:56,722", "tc_out": "00:11:14,473", "reference": "Matthew 5-7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "And Matthew five six and seven is actually in, in chronological order", "note": ""},
    {"id": 34, "display": "LT", "tc_in": "00:11:14,473", "tc_out": "00:11:23,215", "reference": "Matthew 5:3-12", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "let's look at the Beatitudes", "note": "Lead-in"},
    {"id": 35, "display": "FS", "tc_in": "00:11:23,215", "tc_out": "00:11:26,552", "reference": "Matthew 5:3", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "blessed are the poor in spirit, for theirs is the kingdom of heaven", "note": "Reading of verse 3"},
    {"id": 36, "display": "FS", "tc_in": "00:11:27,086", "tc_out": "00:11:30,222", "reference": "Matthew 5:4", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "Blessed are those who mourn, for they will be comforted", "note": "Reading of verse 4"},
    {"id": 37, "display": "FS", "tc_in": "00:11:30,623", "tc_out": "00:11:33,659", "reference": "Matthew 5:5", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "Blessed are the meek, for they shall inherit the earth", "note": "Reading of verse 5"},
    {"id": 38, "display": "FS", "tc_in": "00:11:34,226", "tc_out": "00:11:39,432", "reference": "Matthew 5:6", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "Blessed are those who hunger and thirst for righteousness, for they shall be filled", "note": "Reading of verse 6"},
    {"id": 39, "display": "FS", "tc_in": "00:11:39,432", "tc_out": "00:11:42,468", "reference": "Matthew 5:7", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "Blessed are the merciful, for they will obtain mercy", "note": "Reading of verse 7"},
    {"id": 40, "display": "FS", "tc_in": "00:11:42,468", "tc_out": "00:11:45,838", "reference": "Matthew 5:8", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "Blessed are the pure in heart, for they shall see God", "note": "Reading of verse 8"},
    {"id": 41, "display": "FS", "tc_in": "00:11:46,439", "tc_out": "00:11:50,342", "reference": "Matthew 5:9", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "Blessed are the peacemakers, for they will be called the sons of God", "note": "Reading of verse 9"},
    {"id": 42, "display": "FS", "tc_in": "00:11:50,342", "tc_out": "00:11:56,282", "reference": "Matthew 5:10", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "And blessed are those who are persecuted for righteousness sake, for theirs is the kingdom of God", "note": "Reading of verse 10"},
    {"id": 43, "display": "LT", "tc_in": "00:11:56,282", "tc_out": "00:12:33,185", "reference": "Matthew 5:3-12", "mention_type": "paraphrase", "flag": null, "boundaries_estimated": false, "trigger_quote": "This is what's known or what's called the Beatitudes", "note": "Exposition of the Beatitudes"},
    {"id": 44, "display": "LT", "tc_in": "00:12:46,232", "tc_out": "00:13:02,214", "reference": "Matthew 5-7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "We're talking about Matthew five, six and seven", "note": "After the break"},
    {"id": 45, "display": "FS", "tc_in": "00:13:02,214", "tc_out": "00:13:11,624", "reference": "Matthew 5:1", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "It says, seeing the multitudes, he went up on a mountain. But then, then it says, when he went up on the mountain, he was seated.", "note": "Reading of verse 1 during exposition"},
    {"id": 46, "display": "FS", "tc_in": "00:13:11,624", "tc_out": "00:13:15,561", "reference": "Matthew 5:2", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "he opened his mouth and taught them", "note": "Reading of verse 2 during exposition"},
    {"id": 47, "display": "LT", "tc_in": "00:13:15,561", "tc_out": "00:13:37,116", "reference": "Matthew 5-7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "Matthew five six and seven are, is is the, outline of what's involved", "note": ""},
    {"id": 48, "display": "LT", "tc_in": "00:13:37,116", "tc_out": "00:13:54,967", "reference": "Matthew 7:24", "mention_type": "named_citation", "flag": null, "boundaries_estimated": false, "trigger_quote": "in more in Matthew 724, if you hear these sayings of mine", "note": "Paraphrase of verse 24 on second pass, no reading"},
    {"id": 49, "display": "LT", "tc_in": "00:13:54,967", "tc_out": "00:14:04,443", "reference": "Matthew 5-7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "is what he taught his disciples in Matthew five six and seven", "note": ""},
    {"id": 50, "display": "LT", "tc_in": "00:14:04,443", "tc_out": "00:15:08,340", "reference": "Matthew 5:3-12", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "he starts off with the Beatitudes, the poor in spirit", "note": "Exposition"},
    {"id": 51, "display": "LT", "tc_in": "00:15:08,340", "tc_out": "00:15:13,479", "reference": "Matthew 11:29", "mention_type": "allusion", "flag": "verify", "boundaries_estimated": false, "trigger_quote": "Jesus said, I am meek and I am humble", "note": "Speaker alludes to a saying of Jesus; best-guess verse"},
    {"id": 52, "display": "LT", "tc_in": "00:15:13,712", "tc_out": "00:15:24,223", "reference": "Matthew 5:3-12", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "And if if meekness was synonymous with humility", "note": "Exposition"},
    {"id": 53, "display": "LT", "tc_in": "00:15:24,223", "tc_out": "00:15:34,333", "reference": "Colossians 3:12", "mention_type": "thematic_echo", "flag": "verify", "boundaries_estimated": false, "trigger_quote": "there's another places in the, in the word in the New Testament where, where meekness is distinct from humility in the same list", "note": "Best guess: humility and meekness listed separately"},
    {"id": 54, "display": "LT", "tc_in": "00:15:34,333", "tc_out": "00:16:47,806", "reference": "Matthew 5:3-12", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "You're going to inherit the earth if you'll walk in meekness", "note": "Exposition"},
    {"id": 55, "display": "LT", "tc_in": "00:16:47,806", "tc_out": "00:17:03,055", "reference": "Revelation 4:8", "mention_type": "allusion", "flag": "verify", "boundaries_estimated": false, "trigger_quote": "Oh, there are times I've read the Bible where in revelation where it's saying, but there was, say, spending 24, seven singing Holy, holy, Holy", "note": "Speaker refers to Revelation without a verse"},
    {"id": 56, "display": "LT", "tc_in": "00:17:03,055", "tc_out": "00:18:26,738", "reference": "Matthew 5:3-12", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "Blessed are the merciful. They'll obtain mercy. Blessed are the pure in heart.", "note": "Exposition"},
    {"id": 57, "display": "FS", "tc_in": "00:18:26,738", "tc_out": "00:18:33,479", "reference": "Matthew 5:10", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "And then blessed are those who are persecuted for righteousness sake, for theirs is the kingdom of heaven", "note": "Second reading of verse 10 during exposition"},
    {"id": 58, "display": "LT", "tc_in": "00:18:33,479", "tc_out": "00:19:03,175", "reference": "Matthew 5:11-12", "mention_type": "context_verse", "flag": null, "boundaries_estimated": false, "trigger_quote": "The next verse kind of amplifies it a little bit. It says, look, you're going to rejoice.", "note": "Paraphrase, no reading"},
    {"id": 59, "display": "LT", "tc_in": "00:19:03,175", "tc_out": "00:19:10,849", "reference": "Matthew 5:17-48", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "And so Matthew 517 through 18", "note": "Speaker said 17 through 18, then corrected to 17 through 48 at 00:19:22; using 5:17-48"},
    {"id": 60, "display": "LT", "tc_in": "00:19:10,849", "tc_out": "00:19:20,225", "reference": "Matthew 5:13-16", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "after you get through the Beatitudes and the salt, salt and light", "note": "Named topic, future lessons"},
    {"id": 61, "display": "LT", "tc_in": "00:19:20,225", "tc_out": "00:21:14,573", "reference": "Matthew 5:17-48", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "Matthew 517 through through 48, is is the A represents the childhood stage", "note": "Childhood stage; covers the anger, adultery, vows, retaliation and enemies passages"},
    {"id": 62, "display": "LT", "tc_in": "00:21:14,573", "tc_out": "00:21:53,412", "reference": "Matthew 6", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "Matthew six represents the adolescent stage of our spiritual growth", "note": "Praying, fasting and giving to be seen"},
    {"id": 63, "display": "LT", "tc_in": "00:21:53,412", "tc_out": "00:22:35,220", "reference": "Matthew 7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "Then Matthew seven deals with it's this is represents the adulthood stage", "note": ""},
    {"id": 64, "display": "LT", "tc_in": "00:22:35,220", "tc_out": "00:22:55,040", "reference": "Matthew 5:1", "mention_type": "allusion", "flag": "verify", "boundaries_estimated": false, "trigger_quote": "Jesus saw the multitudes call his disciples to him", "note": "Speaker retells verse 1 without citing it"},
    {"id": 65, "display": "LT", "tc_in": "00:22:55,040", "tc_out": "00:23:00,412", "reference": "Matthew 10:1", "mention_type": "allusion", "flag": "verify", "boundaries_estimated": false, "trigger_quote": "And then he gave them the power to do it", "note": "Best guess: the disciples given power"},
    {"id": 66, "display": "LT", "tc_in": "00:23:00,412", "tc_out": "00:23:09,755", "reference": "Ephesians 4:15-16", "mention_type": "named_citation", "flag": null, "boundaries_estimated": false, "trigger_quote": "Ephesians 415 through 16", "note": "Lead-in"},
    {"id": 67, "display": "FS", "tc_in": "00:23:09,755", "tc_out": "00:23:17,129", "reference": "Ephesians 4:15", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "but speaking the truth and love may grow up in all things into him who is the head, Christ", "note": "Reading of verse 15"},
    {"id": 68, "display": "FS", "tc_in": "00:23:17,129", "tc_out": "00:23:31,610", "reference": "Ephesians 4:16", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "from whom the whole body joined and knit together by what every joint supplies, according to the effective working", "note": "Reading of verse 16"},
    {"id": 69, "display": "LT", "tc_in": "00:23:31,610", "tc_out": "00:23:38,150", "reference": "Ephesians 4:15-16", "mention_type": "paraphrase", "flag": null, "boundaries_estimated": false, "trigger_quote": "God wants us to grow up, and he wants us to grow up into him, into his stature", "note": "Exposition"},
    {"id": 70, "display": "LT", "tc_in": "00:23:38,150", "tc_out": "00:23:41,653", "reference": "Matthew 5-7", "mention_type": "named_range", "flag": null, "boundaries_estimated": false, "trigger_quote": "And that's what Matthew five, six and seven is talking about", "note": ""},
    {"id": 71, "display": "FS", "tc_in": "00:23:41,653", "tc_out": "00:23:52,330", "reference": "1 Peter 2:2", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "First Peter two verse two as newborn babes desire this, the pure milk of the Word of God, that you may grow thereby", "note": "Reading of verse 2"},
    {"id": 72, "display": "LT", "tc_in": "00:23:52,330", "tc_out": "00:23:59,638", "reference": "1 Peter 2:2", "mention_type": "named_citation", "flag": null, "boundaries_estimated": false, "trigger_quote": "How many of you want to grow?", "note": "Expansion"},
    {"id": 73, "display": "FS", "tc_in": "00:23:59,638", "tc_out": "00:24:08,013", "reference": "2 Peter 3:18", "mention_type": "quoted_reading", "flag": null, "boundaries_estimated": false, "trigger_quote": "Second Peter 318 but grow in the grace and knowledge of our Lord and Savior Jesus Christ", "note": "Reading of verse 18"},
